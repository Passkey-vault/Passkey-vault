# Stellar network the app talks to. Only testnet is supported for now.
VITE_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
VITE_RPC_URL=https://soroban-testnet.stellar.org
VITE_FRIENDBOT_URL=https://friendbot.stellar.org
VITE_EXPLORER_URL=https://stellar.expert/explorer/testnet
# WebAuthn relying party id that new vaults are bound to. Defaults to the page's
# hostname; set it if you serve the app from several subdomains of one domain.
# VITE_RP_ID=example.com
# Hash of the uploaded passkey-vault wasm (stellar contract upload ...).
VITE_VAULT_WASM_HASH=13083897d376d4a65ca1f905d4c72d3be57e26de78929ea44b1d289c19360b13
